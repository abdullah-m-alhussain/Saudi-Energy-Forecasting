# --------------------------------------------------
# Benchmark Datasets
# --------------------------------------------------
# Raw benchmark datasets are obtained separately.
# Processed benchmark datasets are regenerated by the notebooks.

# Ignore all benchmark raw datasets
benchmarks/*/data/raw/*

# Ignore all benchmark processed datasets
benchmarks/*/data/processed/*

# Keep the directory structure
!benchmarks/*/data/raw/.gitkeep
!benchmarks/*/data/processed/.gitkeep


# --------------------------------------------------
# Generated Benchmark Artifacts
# --------------------------------------------------

# Trained models
benchmarks/*/models/*
!benchmarks/*/models/.gitkeep

# Generated prediction outputs
benchmarks/*/results/predictions.csv
benchmarks/*/results/predictions.xlsx
benchmarks/*/results/forecast*.csv
benchmarks/*/results/*prediction*.csv